/*
Margin classes
=============================================================================
*/

/* Resets */
._m0 { margin: 0; }
._mt0 { margin-top: 0; }
._mr0 { margin-right: 0; }
._mb0 { margin-bottom: 0; }
._ml0 { margin-left: 0; }

/* All the sides */
._mxs { margin: var(--spacing-xs); }
._ms { margin: var(--spacing-s); }
._mm { margin: var(--spacing-m); }
._ml { margin: var(--spacing-l); }
._mxl { margin: var(--spacing-xl); }

/* Extra small */
._mtxs { margin-top: var(--spacing-xs); }
._mrxs { margin-right: var(--spacing-xs); }
._mbxs { margin-bottom: var(--spacing-xs); }
._mlxs { margin-left: var(--spacing-xs); }

/* Small */
._mts { margin-top: var(--spacing-s); }
._mrs { margin-right: var(--spacing-s); }
._mbs { margin-bottom: var(--spacing-s); }
._mls { margin-left: var(--spacing-s); }

/* Medium */
._mtm { margin-top: var(--spacing-m); }
._mrm { margin-right: var(--spacing-m); }
._mbm { margin-bottom: var(--spacing-m); }
._mlm { margin-left: var(--spacing-m); }

/* Large */
._mtl { margin-top: var(--spacing-l); }
._mrl { margin-right: var(--spacing-l); }
._mbl { margin-bottom: var(--spacing-l); }
._mll { margin-left: var(--spacing-l); }

/* Extra Large */
._mtxl { margin-top: var(--spacing-xl); }
._mrxl { margin-right: var(--spacing-xl); }
._mbxl { margin-bottom: var(--spacing-xl); }
._mlxl { margin-left: var(--spacing-xl); }