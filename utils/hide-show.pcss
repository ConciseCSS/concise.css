/*
Hide/Show classes
=============================================================================
*/

/*
Extra-Small Devices
-------------------
*/

._show-xs,
._hide-s,
._hide-m,
._hide-l,
._hide-xl,
._hide-print,
._hide-hd {
  display: block;
  visibility: visible;
}

._hide-xs,
._show-s,
._show-m,
._show-l,
._show-xl,
._show-print,
._show-hd {
  display: none;
  visibility: hidden;
}


/*
Small Devices
-------------
*/

@media (--small) {
  ._show-s,
  ._hide-xs,
  ._hide-m,
  ._hide-l,
  ._hide-xl {
    display: block;
    visibility: visible;
  }

  ._hide-s,
  ._show-xs,
  ._show-m,
  ._show-l,
  ._show-xl {
    display: none;
    visibility: hidden;
  }
}


/*
Medium Devices
--------------
*/

@media (--medium) {
  ._show-m,
  ._hide-xs,
  ._hide-s,
  ._hide-l,
  ._hide-xl {
    display: block;
    visibility: visible;
  }

  ._hide-m,
  ._show-xs,
  ._show-s,
  ._show-l,
  ._show-xl {
    display: none;
    visibility: hidden;
  }
}


/*
Large Devices
-------------
*/

@media (--large) {
  ._show-l,
  ._hide-xs,
  ._hide-s,
  ._hide-m,
  ._hide-xl {
    display: block;
    visibility: visible;
  }

  ._hide-l,
  ._show-xs,
  ._show-s,
  ._show-m,
  ._show-xl {
    display: none;
    visibility: hidden;
  }
}


/*
Extra-Large Devices
-------------------
*/

@media (--extra-large) {
  ._show-xl,
  ._hide-xs,
  ._hide-s,
  ._hide-m,
  ._hide-l {
    display: block;
    visibility: visible;
  }

  ._hide-xl,
  ._show-xs,
  ._show-s,
  ._show-m,
  ._show-l {
    display: none;
    visibility: hidden;
  }
}


/*
Print
-----
*/

@media print {
  ._show-print {
    display: block;
    visibility: visible;
  }

  ._hide-print {
    display: none;
    visibility: hidden;
  }
}


/*
HiDPI and Retina
----------------
*/

@media (min-resolution: 1.5dppx) {
  ._show-hd {
    display: block;
    visibility: visible;
  }

  ._hide-hd {
    display: none;
    visibility: hidden;
  }
}
