  ._m5-s { margin: var(--spacing-xl); }
  ._mt5-s { margin-top: var(--spacing-xl); }
  ._mr5-s { margin-right: var(--spacing-xl); }
  ._mb5-s { margin-bottom: var(--spacing-xl); }
  ._ml5-s { margin-left: var(--spacing-xl); }
  ._mv5-s { margin-top: var(--spacing-xl); margin-bottom: var(--spacing-xl); }
  ._mh5-s { margin-left: var(--spacing-xl); margin-right: var(--spacing-xl); }
}

