  ._mb2-s { margin-bottom: var(--spacing-s); }
  ._ml2-s { margin-left: var(--spacing-s); }
  ._mv2-s { margin-top: var(--spacing-s); margin-bottom: var(--spacing-s); }
  ._mh2-s { margin-left: var(--spacing-s); margin-right: var(--spacing-s); }

  ._m3-s { margin: var(--spacing-m); }
  ._mt3-s { margin-top: var(--spacing-m); }
  ._mr3-s { margin-right: var(--spacing-m); }
  ._mb3-s { margin-bottom: var(--spacing-m); }
  ._ml3-s { margin-left: var(--spacing-m); }
  ._mv3-s { margin-top: var(--spacing-m); margin-bottom: var(--spacing-m); }
  ._mh3-s { margin-left: var(--spacing-m); margin-right: var(--spacing-m); }

  ._m4-s { margin: var(--spacing-l); }
  ._mt4-s { margin-top: var(--spacing-l); }
  ._mr4-s { margin-right: var(--spacing-l); }
  ._mb4-s { margin-bottom: var(--spacing-l); }
  ._ml4-s { margin-left: var(--spacing-l); }
  ._mv4-s { margin-top: var(--spacing-l); margin-bottom: var(--spacing-l); }
