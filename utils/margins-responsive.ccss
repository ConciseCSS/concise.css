  ._ml5-m { margin-left: var(--spacing-xl); }
  ._mv5-m { margin-top: var(--spacing-xl); margin-bottom: var(--spacing-xl); }
  ._mh5-m { margin-left: var(--spacing-xl); margin-right: var(--spacing-xl); }
}

@media (--large) {
  ._m0-l { margin: 0; }
  ._mt0-l { margin-top: 0; }
  ._mr0-l { margin-right: 0; }
  ._mb0-l { margin-bottom: 0; }
  ._ml0-l { margin-left: 0; }
  ._mv0-l { margin-top: 0; margin-bottom: 0; }
  ._mh0-l { margin-left: 0; margin-right: 0; }

  ._m1-l { margin: var(--spacing-xs); }
  ._mt1-l { margin-top: var(--spacing-xs); }
  ._mr1-l { margin-right: var(--spacing-xs); }
  ._mb1-l { margin-bottom: var(--spacing-xs); }
  ._ml1-l { margin-left: var(--spacing-xs); }
