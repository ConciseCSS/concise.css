//
// Responsive margins (opt-in)
// =============================================================================
//
// Not part of utils/index.ccss. Import it on its own:
//   @import 'concise.css/utils/margins-responsive';
//
// Sizes: 0 = none, 1 = xs, 2 = s, 3 = m, 4 = l, 5 = xl (the --spacing-* settings)
// Sides: m (all), mt, mr, mb, ml, mv (vertical), mh (horizontal)
// Suffixes -s, -m, -l, -xl apply from that breakpoint up, e.g. ._mt2-m

@import '../core/settings.ccss';

._m0 { margin: 0; }
._mt0 { margin-top: 0; }
._mr0 { margin-right: 0; }
._mb0 { margin-bottom: 0; }
._ml0 { margin-left: 0; }
._mv0 { margin-top: 0; margin-bottom: 0; }
._mh0 { margin-left: 0; margin-right: 0; }

._m1 { margin: var(--spacing-xs); }
._mt1 { margin-top: var(--spacing-xs); }
._mr1 { margin-right: var(--spacing-xs); }
._mb1 { margin-bottom: var(--spacing-xs); }
._ml1 { margin-left: var(--spacing-xs); }
._mv1 { margin-top: var(--spacing-xs); margin-bottom: var(--spacing-xs); }
._mh1 { margin-left: var(--spacing-xs); margin-right: var(--spacing-xs); }

._m2 { margin: var(--spacing-s); }
._mt2 { margin-top: var(--spacing-s); }
._mr2 { margin-right: var(--spacing-s); }
._mb2 { margin-bottom: var(--spacing-s); }
._ml2 { margin-left: var(--spacing-s); }
._mv2 { margin-top: var(--spacing-s); margin-bottom: var(--spacing-s); }
._mh2 { margin-left: var(--spacing-s); margin-right: var(--spacing-s); }

._m3 { margin: var(--spacing-m); }
._mt3 { margin-top: var(--spacing-m); }
._mr3 { margin-right: var(--spacing-m); }
._mb3 { margin-bottom: var(--spacing-m); }
._ml3 { margin-left: var(--spacing-m); }
._mv3 { margin-top: var(--spacing-m); margin-bottom: var(--spacing-m); }
._mh3 { margin-left: var(--spacing-m); margin-right: var(--spacing-m); }

._m4 { margin: var(--spacing-l); }
._mt4 { margin-top: var(--spacing-l); }
._mr4 { margin-right: var(--spacing-l); }
._mb4 { margin-bottom: var(--spacing-l); }
._ml4 { margin-left: var(--spacing-l); }
._mv4 { margin-top: var(--spacing-l); margin-bottom: var(--spacing-l); }
._mh4 { margin-left: var(--spacing-l); margin-right: var(--spacing-l); }

._m5 { margin: var(--spacing-xl); }
._mt5 { margin-top: var(--spacing-xl); }
._mr5 { margin-right: var(--spacing-xl); }
._mb5 { margin-bottom: var(--spacing-xl); }
._ml5 { margin-left: var(--spacing-xl); }
._mv5 { margin-top: var(--spacing-xl); margin-bottom: var(--spacing-xl); }
._mh5 { margin-left: var(--spacing-xl); margin-right: var(--spacing-xl); }

