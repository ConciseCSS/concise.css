  ._m4-m { margin: var(--spacing-l); }
  ._mt4-m { margin-top: var(--spacing-l); }
  ._mr4-m { margin-right: var(--spacing-l); }
  ._mb4-m { margin-bottom: var(--spacing-l); }
  ._ml4-m { margin-left: var(--spacing-l); }
  ._mv4-m { margin-top: var(--spacing-l); margin-bottom: var(--spacing-l); }
  ._mh4-m { margin-left: var(--spacing-l); margin-right: var(--spacing-l); }

  ._m5-m { margin: var(--spacing-xl); }
  ._mt5-m { margin-top: var(--spacing-xl); }
  ._mr5-m { margin-right: var(--spacing-xl); }
