/*
Padding classes
=============================================================================
*/

/* Resets */
._p0 { padding: 0; }
._pt0 { padding-top: 0; }
._pr0 { padding-right: 0; }
._pb0 { padding-bottom: 0; }
._pl0 { padding-left: 0; }

/* All the sides */
._pxs { padding: var(--spacing-xs); }
._ps { padding: var(--spacing-s); }
._pm { padding: var(--spacing-m); }
._pl { padding: var(--spacing-l); }
._pxl { padding: var(--spacing-xl); }

/* Extra small */
._ptxs { padding-top: var(--spacing-xs); }
._prxs { padding-right: var(--spacing-xs); }
._pbxs { padding-bottom: var(--spacing-xs); }
._plxs { padding-left: var(--spacing-xs); }

/* Small */
._pts { padding-top: var(--spacing-s); }
._prs { padding-right: var(--spacing-s); }
._pbs { padding-bottom: var(--spacing-s); }
._pls { padding-left: var(--spacing-s); }

/* Medium */
._ptm { padding-top: var(--spacing-m); }
._prm { padding-right: var(--spacing-m); }
._pbm { padding-bottom: var(--spacing-m); }
._plm { padding-left: var(--spacing-m); }

/* Large */
._ptl { padding-top: var(--spacing-l); }
._prl { padding-right: var(--spacing-l); }
._pbl { padding-bottom: var(--spacing-l); }
._pll { padding-left: var(--spacing-l); }

/* Extra Large */
._ptxl { padding-top: var(--spacing-xl); }
._prxl { padding-right: var(--spacing-xl); }
._pbxl { padding-bottom: var(--spacing-xl); }
._plxl { padding-left: var(--spacing-xl); }