/**
 * Concise Utils
 * Helper classes, prefixed with an underscore (`_`), for prototyping and
 * context-dependent styles.
 *
 * Responsive margins are opt-in:
 *   @import 'concise.css/utils/margins-responsive';
 */

// Settings (custom properties and media queries); imported only once even
// when core is imported too
@import '../core/settings.pcss';

@import 'margins.pcss';
@import 'paddings.pcss';
@import 'borders.pcss';
@import 'colors.pcss';
@import 'hide-show.pcss';
@import 'type-scale.pcss';
@import 'typography.pcss';
@import 'position.pcss';
@import 'display.pcss';
@import 'columns.pcss';
