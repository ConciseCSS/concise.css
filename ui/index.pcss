/**
 * Concise UI
 * A basic user interface kit: components and elements following the RSCSS
 * convention (https://github.com/rstacruz/rscss).
 */

/*
Settings (custom properties and media queries); imported only once even
when core is imported too
*/
@import '../core/settings.pcss';

/*******************************************************************************
Components
                                                                              */

@import 'components/alert-box.pcss';
@import 'components/breadcrumb-nav.pcss';
@import 'components/button-group.pcss';
@import 'components/card-box.pcss';
@import 'components/dropdown-button.pcss';
@import 'components/progress-bar.pcss';

/*******************************************************************************
Elements
                                                                              */

@import 'elements/tag.pcss';
@import 'elements/button.pcss';
@import 'elements/spinner.pcss';
