//
// Breadcrumbs
// =============================================================================

.breadcrumb-nav {
  background-color: var(--color-background-light);
  font-size: 1;
  padding: 0.5rlh 1.5em;
  font-weight: bold;

  //
  // Breadcrumb item
  // --------------------------------------------------

  & > .item {
    display: inline;
    list-style: none;
    margin-right: 1em;

    // Add a separator to all the elements
    // except the last one
    &:not(:last-child):after {
      color: var(--color-base-lines);
      content: "/";
      margin-left: 1em;
    }

    // Active item
    &.-active,
    &.-active a {
      color: var(--color-text-secondary);
      font-weight: normal;
    }
  }
}
