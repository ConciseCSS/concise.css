/*
Alerts
=============================================================================
*/

.alert-box {
  background-color: var(--color-background-light);
  border: 1px solid var(--color-base-lines);
  font-size: 1;
  padding: 0.5rlh 1em;
  position: relative;
  color: var(--color-text-secondary);

  /*****************************************************************************
  Close button
                                                                              */

  & > .close {
    color: inherit;
    position: absolute;
    right: 1em;
    top: 0.8em;
    opacity: 0.5;
    transition: opacity var(--transition-duration);

    &:hover { opacity: 1; }
  }

  /*****************************************************************************
  States
  One variant for each state color in core/settings.pcss
                                                                              */

  &.-muted {
    background-color: rgb(from var(--color-state-muted) r g b / 15%);
    border-color: rgb(from var(--color-state-muted) r g b / 20%);
    color: hsl(from var(--color-state-muted) h s calc(l - 10));

    a { color: hsl(from var(--color-state-muted) h s calc(l - 20)); }
  }

  &.-success {
    background-color: rgb(from var(--color-state-success) r g b / 15%);
    border-color: rgb(from var(--color-state-success) r g b / 20%);
    color: hsl(from var(--color-state-success) h s calc(l - 10));

    a { color: hsl(from var(--color-state-success) h s calc(l - 20)); }
  }

  &.-warning {
    background-color: rgb(from var(--color-state-warning) r g b / 15%);
    border-color: rgb(from var(--color-state-warning) r g b / 20%);
    color: hsl(from var(--color-state-warning) h s calc(l - 10));

    a { color: hsl(from var(--color-state-warning) h s calc(l - 20)); }
  }

  &.-error {
    background-color: rgb(from var(--color-state-error) r g b / 15%);
    border-color: rgb(from var(--color-state-error) r g b / 20%);
    color: hsl(from var(--color-state-error) h s calc(l - 10));

    a { color: hsl(from var(--color-state-error) h s calc(l - 20)); }
  }
}
