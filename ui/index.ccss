/**
 * Concise UI
 * A basic user interface kit: components and elements following the RSCSS
 * convention (https://rscss.io).
 */

// Settings (custom properties and media queries); imported only once even
// when core is imported too
@import '../core/settings.ccss';

//
// Components
// --------------------------------------------------

@import 'components/alert-box.ccss';
@import 'components/breadcrumb-nav.ccss';
@import 'components/button-group.ccss';
@import 'components/card-box.ccss';
@import 'components/dropdown-button.ccss';
@import 'components/progress-bar.ccss';

//
// Elements
// --------------------------------------------------

@import 'elements/tag.ccss';
@import 'elements/button.ccss';
@import 'elements/spinner.ccss';
