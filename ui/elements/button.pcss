/*
Buttons
=============================================================================
*/

button {
  overflow: hidden;

  /*
  Bordered variant
  --------------------------------------------------
  */

  &.-bordered {
    background-color: transparent;
    border: 1px solid var(--color-base-primary);
    color: var(--color-base-primary);

    &:hover,
    &:focus {
      background-color: var(--color-base-primary);
      color: var(--color-text-inverted);
    }

    &[disabled] {
      border-color: var(--color-state-muted);
      color: var(--color-state-muted);

      &:hover,
      &:focus,
      &:active {
        background-color: transparent;
        border-color: var(--color-state-muted);
        color: var(--color-state-muted);
      }
    }

    /* State variants */
    &.-muted {
      border-color: var(--color-state-muted);
      background-color: transparent;
      color: var(--color-state-muted);

      &:hover,
      &:focus { background-color: var(--color-state-muted); }

      &:active { background-color: hsl(from var(--color-state-muted) h s calc(l + 5)); }

      &:hover,
      &:focus,
      &:active { color: var(--color-text-inverted); }
    }

    &.-success {
      border-color: var(--color-state-success);
      background-color: transparent;
      color: var(--color-state-success);

      &:hover,
      &:focus { background-color: var(--color-state-success); }

      &:active { background-color: hsl(from var(--color-state-success) h s calc(l + 5)); }

      &:hover,
      &:focus,
      &:active { color: var(--color-text-inverted); }
    }

    &.-warning {
      border-color: var(--color-state-warning);
      background-color: transparent;
      color: var(--color-state-warning);

      &:hover,
      &:focus { background-color: var(--color-state-warning); }

      &:active { background-color: hsl(from var(--color-state-warning) h s calc(l + 5)); }

      &:hover,
      &:focus,
      &:active { color: var(--color-text-inverted); }
    }

    &.-error {
      border-color: var(--color-state-error);
      background-color: transparent;
      color: var(--color-state-error);

      &:hover,
      &:focus { background-color: var(--color-state-error); }

      &:active { background-color: hsl(from var(--color-state-error) h s calc(l + 5)); }

      &:hover,
      &:focus,
      &:active { color: var(--color-text-inverted); }
    }
  }

  /*
  State variants
  --------------------------------------------------
  */

  &.-muted {
    background-color: var(--color-state-muted);
    color: var(--color-text-inverted);

    &:hover,
    &:focus { background-color: hsl(from var(--color-state-muted) h s calc(l + 5)); }

    &:active { background-color: hsl(from var(--color-state-muted) h s calc(l + 10)); }
  }

  &.-success {
    background-color: var(--color-state-success);
    color: var(--color-text-inverted);

    &:hover,
    &:focus { background-color: hsl(from var(--color-state-success) h s calc(l + 5)); }

    &:active { background-color: hsl(from var(--color-state-success) h s calc(l + 10)); }
  }

  &.-warning {
    background-color: var(--color-state-warning);
    color: var(--color-text-inverted);

    &:hover,
    &:focus { background-color: hsl(from var(--color-state-warning) h s calc(l + 5)); }

    &:active { background-color: hsl(from var(--color-state-warning) h s calc(l + 10)); }
  }

  &.-error {
    background-color: var(--color-state-error);
    color: var(--color-text-inverted);

    &:hover,
    &:focus { background-color: hsl(from var(--color-state-error) h s calc(l + 5)); }

    &:active { background-color: hsl(from var(--color-state-error) h s calc(l + 10)); }
  }

  /*
  Prefix variant
  --------------------------------------------------
  */

  &.-prefix {
    padding-left: 0;

    .prefix {
      background-color: rgba(0,0,0,0.15);
      display: inline-block;
      margin-right: 1.25em;
      padding: 0 1em;
      vertical-align: 0;
    }
  }

  /*
  Affix variant
  --------------------------------------------------
  */

  &.-affix {
    padding-right: 0;

    & > .affix {
      background-color: rgba(0,0,0,0.15);
      display: inline-block;
      margin-left: 1.25em;
      padding: 0 1em;
      vertical-align: 0;
    }
  }
}
