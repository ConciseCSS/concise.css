//
// Spinner
// =============================================================================

.spinner {
  animation: rotate .8s infinite linear;
  border: 3px solid hsl(from var(--color-background-light) h s calc(l - 25));
  border-radius: 50%;
  border-right-color: transparent;
  height: 40px;
  margin: 1rlh auto;
  width: 40px;
}

@keyframes rotate {
  0% { transform: rotate(0deg); }

  100% { transform: rotate(360deg); }
}
